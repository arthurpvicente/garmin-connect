# .env.example  —  copy to .env and fill in real values
# .env is in .gitignore — never commit it
 
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:8000/auth/callback
 
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
GARMINTOKENS=.garminconnect
 
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitness_sync
REDIS_URL=redis://localhost:6379/0
 
# Generate (in terminal) with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_with_generated_key
 
DEBUG=true
LOG_LEVEL=INFO

# RAG Training Assistant (optional) — required for /assistant/ask
# Get your free key at aistudio.google.com → "Get API key" (no credit card needed)
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-2

# Twilio WhatsApp (optional) — for weekly fitness reports
# 1. Sign up at twilio.com → copy Account SID + Auth Token from Console
# 2. Messaging → Try it out → WhatsApp sandbox: send the "join <code>" message to +1 415 523 8886
# 3. From = the sandbox number, To = your WhatsApp number (with country code)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+15551234567
